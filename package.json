{
  "name": "sd-prompt-studio",
  "private": true,
  "version": "1.0.0-beta.21.0-alpha.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/validate-research-explorer-boundaries.mjs && tsc && vite build && node scripts/validate-research-explorer-boundaries.mjs --dist dist",
    "build:research-local": "node scripts/validate-research-explorer-boundaries.mjs && tsc && vite build --base / && node scripts/validate-research-explorer-boundaries.mjs --dist dist",
    "test": "node scripts/test-reclassification.mjs && node scripts/test-prompt-analyzer.mjs && node scripts/test-user-dictionary-import.mjs && node scripts/test-research-explorer-boundaries.mjs && node scripts/test-research-explorer-ui.mjs",
    "test:prompt-analyzer": "node scripts/test-prompt-analyzer.mjs",
    "test:user-dictionary-import": "node scripts/test-user-dictionary-import.mjs",
    "test:visual-concept-read-only-entry": "node scripts/test-visual-concept-read-only-entry-adapter-v1.mjs",
    "test:visual-concept-read-only-inspection": "node scripts/test-visual-concept-read-only-inspection-v1.mjs",
    "test:visual-concept-read-only-advisory": "node scripts/test-visual-concept-read-only-advisory-v1.mjs",
    "inspect:visual-concept": "node scripts/inspect-visual-concept-read-only-v1.mjs",
    "advise:visual-concept": "node scripts/visual-concept-read-only-advisory-v1.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "validate:dictionary": "node scripts/validate-dictionaries.mjs",
    "validate:research-boundaries": "node scripts/validate-research-explorer-boundaries.mjs",
    "dev:local": "vite --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "markdown-to-jsx": "^9.8.2",
    "react": "latest",
    "react-dom": "latest",
    "react-syntax-highlighter": "^16.1.1",
    "typescript": "latest",
    "vite": "latest",
    "yaml": "^2.9.0",
    "zustand": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/react-syntax-highlighter": "^15.5.13"
  }
}
