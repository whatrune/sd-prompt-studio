      "prefixes": []
    },
    {
      "profile": "PROMPT_DATA",
      "exact": [],
      "prefixes": ["data/"]
    },
    {
      "profile": "APPLICATION",
      "exact": [
        "index.html",
        "package.json",
        "pnpm-lock.yaml",
        "tsconfig.app.json",
        "tsconfig.json",
        "tsconfig.node.json",
        "vite.config.ts"
      ],
      "prefixes": ["public/", "src/"]
