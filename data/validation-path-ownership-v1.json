    {
      "profile": "PLATFORM",
      "exact": [".github/pull_request_template.md", "AGENTS.md"],
      "prefixes": [".github/workflows/", "docs/team/", "scripts/"]
    },
    {
      "profile": "DOCUMENTATION",
      "exact": ["README.md"],
      "prefixes": ["docs/"]
