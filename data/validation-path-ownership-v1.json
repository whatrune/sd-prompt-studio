      "runtime_deployable": true,
      "bundles": ["full_research", "research_validators", "production_advisory", "prompt_data", "application", "platform"]
    },
    "PRODUCTION_ADVISORY": {
      "runtime_deployable": true,
      "bundles": ["production_advisory"]
    },
    "PROMPT_DATA": {
      "runtime_deployable": true,
      "bundles": ["prompt_data"]
    },
    "APPLICATION": {
      "runtime_deployable": true,
      "bundles": ["application"]
    },
    "PLATFORM": {
      "runtime_deployable": true,
      "bundles": ["platform"]
    },
    "DOCUMENTATION": {
      "runtime_deployable": false,
      "bundles": []
    }
  },
  "force_full": {
