{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.sd-prompt-studio/hair-observation-schema-v1.json",
  "title": "SD Prompt Studio Optional Hair Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "blind_condition_label", "panel_count",
    "hair_observation"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "blind_condition_label": {"type": "string", "minLength": 1},
    "panel_count": {"const": 6},
    "hair_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "active_axis_order", "panels"],
      "properties": {
        "enabled": {"const": true},
        "active_axis_order": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {"const": "hair_length_extent"},
            {"const": "neck_hair_overlap"},
            {"const": "shoulder_hair_overlap"},
            {"const": "hair_identity_clarity"}
          ],
          "items": false
        },
        "panels": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": {"$ref": "#/$defs/panel"}
        }
      }
    },
    "computed_aggregate": {"$ref": "#/$defs/computedAggregate"}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0, "maximum": 6},
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel_id", "hair_length_extent", "neck_hair_overlap",
        "shoulder_hair_overlap", "hair_identity_clarity",
        "evidence_notes", "confidence"
      ],
      "properties": {
        "panel_id": {"type": "integer", "minimum": 1, "maximum": 6},
        "hair_length_extent": {
          "enum": [
            "above_neck", "neck_to_shoulder", "below_shoulder",
            "waist_or_longer", "unclear", "not_visible"
          ]
        },
        "neck_hair_overlap": {"enum": ["present", "absent", "unclear", "not_visible"]},
        "shoulder_hair_overlap": {"enum": ["present", "absent", "unclear", "not_visible"]},
        "hair_identity_clarity": {
          "enum": [
            "distinct", "ambiguous_with_clothing", "ambiguous_with_background",
            "artifact", "not_visible"
          ]
        },
        "evidence_notes": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    },
    "hairLengthCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "above_neck", "neck_to_shoulder", "below_shoulder",
        "waist_or_longer", "unclear", "not_visible"
      ],
      "properties": {
        "above_neck": {"$ref": "#/$defs/count"},
        "neck_to_shoulder": {"$ref": "#/$defs/count"},
        "below_shoulder": {"$ref": "#/$defs/count"},
        "waist_or_longer": {"$ref": "#/$defs/count"},
        "unclear": {"$ref": "#/$defs/count"},
        "not_visible": {"$ref": "#/$defs/count"}
      }
    },
    "overlapCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "absent", "unclear", "not_visible"],
      "properties": {
        "present": {"$ref": "#/$defs/count"},
        "absent": {"$ref": "#/$defs/count"},
        "unclear": {"$ref": "#/$defs/count"},
        "not_visible": {"$ref": "#/$defs/count"}
      }
    },
    "identityCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distinct", "ambiguous_with_clothing", "ambiguous_with_background",
        "artifact", "not_visible"
      ],
      "properties": {
        "distinct": {"$ref": "#/$defs/count"},
        "ambiguous_with_clothing": {"$ref": "#/$defs/count"},
        "ambiguous_with_background": {"$ref": "#/$defs/count"},
        "artifact": {"$ref": "#/$defs/count"},
        "not_visible": {"$ref": "#/$defs/count"}
      }
    },
    "computedAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis_counts"],
      "properties": {
        "axis_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hair_length_extent", "neck_hair_overlap",
            "shoulder_hair_overlap", "hair_identity_clarity"
          ],
          "properties": {
            "hair_length_extent": {"$ref": "#/$defs/hairLengthCounts"},
            "neck_hair_overlap": {"$ref": "#/$defs/overlapCounts"},
            "shoulder_hair_overlap": {"$ref": "#/$defs/overlapCounts"},
            "hair_identity_clarity": {"$ref": "#/$defs/identityCounts"}
          }
        }
      }
    }
  }
}
